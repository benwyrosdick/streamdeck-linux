[Unit]
Description=Stream Deck service (devices, profiles, plugins)
Documentation=file:///usr/share/doc/streamdeck-linux/README.md
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=/usr/bin/streamdeckd
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
